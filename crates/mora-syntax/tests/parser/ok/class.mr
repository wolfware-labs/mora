public class Counter {
    public Name: string;
    public mut(private) Step: int = 1;
    public Doubled: int => Step * 2;
    const Limit: int = 1 << 10;
    mut _count: int;
    mut _peak: int = 0;

    public Counter(name: string, step: int) {
        Name = name;
    }

    public Counter(name: string) : this(name, 1) { }

    ~Counter() { }

    Reset(): () { }

    Pair(): (int, string,) => (1, "a");

    Named(): (x: int, y: string) => (x: 1, y: "a");

    public this[i: int]: int { get => i; set => _count = value; }

    public Max<T>(a: T, b: T): T where T : IComparable<T> => a;

    public Add(in other: Counter, ref total: int, params rest: ReadOnlySpan<int>, port: int = 80) { }

    public Sort(compare: (int, int) => int, done: () => ()) { }

    public OnTick: ((int) => ());

    public Pair(): (int, int) => (1, 2);

    public static operator +(a: Counter, b: Counter): Counter => a;

    public static operator -(a: Counter): Counter => a;

    IShape.Area(): float => 0.0f;

    IList<int>.Count: int => 0;

    IList<int>.this[i: int]: int { get => i; }

    public async Load(id: UserId): Result<User, E> { }
}

public unique class Connection {
    public Close() { }
}
