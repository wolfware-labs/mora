public interface IShape : IDisplay
{
    Area(): float;
    Name: string => "shape";
    Log(m: string);
    static abstract Unit: IShape { get; }
    type Points : IEnumerable<Point>;
}

@Derive
public macro Equatable(t: TypeInfo) adds IEquatable<T>
{
    return code { };
}

@Import("c")
static extern puts(s: ReadOnlySpan<byte>): int;
