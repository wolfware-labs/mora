/// A point on the plane.
public struct Point {
    public X: int;
    public Y: int;
    mut _visits: int = 0;
    public Parent: weak Node;
    public Shape: any IShape;
    public Shapes: List<any IShape>?;
}

public ref struct Cursor<T> where T : struct {
    _items: Span<T>;
}

public struct Pair<A, B> : IEquatable<Pair<A, B>> where A : IEquatable<A>, IDefault, allows move where B : allows ref struct;
