public struct User(Id: int, Name: string);
public struct Money(Cents: long) : IComparable<Money>;
struct Tag(Value: string) {
    public Upper: string => Value;
}

public union Json {
    Null,
    Bool(Value: bool),
    @Default Number(Value: double),
    indirect Array(Items: List<Json>);

    public IsNull: bool => false;
}

enum Color : byte { Red, Green = 2, Blue = Green + 1, }
