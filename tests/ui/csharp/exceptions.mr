Parse(text: string): int
{
    try //~ ERROR MR0101
    {
        return int.Parse(text);
    }
    catch (FormatException e) when (e.Message != "")
    {
        throw; //~ ERROR MR0101
    }
    finally
    {
        Console.WriteLine("done");
    }
}
Fallback(x: int?): int => x ?? throw new ArgumentException(); //~ ERROR MR0101
